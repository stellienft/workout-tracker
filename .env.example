# Supabase project settings — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used for admin server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app (used in auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend — https://resend.com). Optional: if unset, the
# new-member admin notification silently no-ops.
RESEND_API_KEY=your-resend-api-key
# Sender. Default "Stellio Fit <onboarding@resend.dev>" works to the Resend
# account owner immediately; use an address on your verified domain in prod.
EMAIL_FROM=Stellio Fit <noreply@stellio.fit>
# Where new-member notifications are sent (defaults to hello@stellio.com.au)
ADMIN_EMAIL=hello@stellio.com.au

# --- Spotify (workout "now playing" + Home Hub voice playback control) ---
# Dashboard: https://developer.spotify.com/dashboard. Register the redirect URI
# <origin>/api/spotify/callback. Playback control needs a Spotify Premium
# account; free accounts can still show what's playing.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# --- Web push (rest timers, reminders, Home Hub alarm backup) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@stellio.com.au

# Shared secret for the scheduled jobs in vercel.json (reminders, motivation,
# and the every-minute Home Hub alarm sender).
CRON_SECRET=a-long-random-string

# Optional. Powers the AI coach and the Home Hub's fallback interpreter, which
# handles phrasings the local parser misses plus general questions. Without it
# the hub still works — it just answers "sorry, I didn't catch that" more often.
ANTHROPIC_API_KEY=your-anthropic-api-key
